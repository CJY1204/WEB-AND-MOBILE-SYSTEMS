@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "Reports";
    ViewBag.ActiveMenu = "Report";
}

<div class="admin-page-header">
    <div>
        <h2>Reports</h2>
    </div>
</div>

<div class="row">
    <div class="col-md-4 mb-4">
        <a asp-controller="Admin" asp-action="Daily" class="text-decoration-none">
            <div class="admin-table-card p-4 h-100 text-center">
                <i class="fa-solid fa-calendar-day fs-1 text-orange mb-3"></i>
                <h5 class="fw-bold text-dark">Daily Sales Report</h5>
                <p class="text-muted small mb-0">Revenue, orders, and items sold for a single day.</p>
            </div>
        </a>
    </div>
    <div class="col-md-4 mb-4">
        <a asp-controller="Admin" asp-action="Monthly" class="text-decoration-none">
            <div class="admin-table-card p-4 h-100 text-center">
                <i class="fa-solid fa-calendar-days fs-1 text-orange mb-3"></i>
                <h5 class="fw-bold text-dark">Monthly Sales Report</h5>
                <p class="text-muted small mb-0">Day-by-day breakdown plus top items for the month.</p>
            </div>
        </a>
    </div>
    <div class="col-md-4 mb-4">
        <a asp-controller="Admin" asp-action="TopSelling" class="text-decoration-none">
            <div class="admin-table-card p-4 h-100 text-center">
                <i class="fa-solid fa-fire fs-1 text-orange mb-3"></i>
                <h5 class="fw-bold text-dark">Top-Selling Foods</h5>
                <p class="text-muted small mb-0">Best-selling dishes across any custom date range.</p>
            </div>
        </a>
    </div>
</div>
