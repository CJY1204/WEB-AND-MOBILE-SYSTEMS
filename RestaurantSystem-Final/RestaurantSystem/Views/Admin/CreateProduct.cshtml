@model Product
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Create Product";
    ViewBag.ActiveMenu = "Products";
}

<div class="admin-page-header">
    <div>
        <h2>Create Product</h2>
        <span class="text-muted small">Add a new item to the menu</span>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 p-4">
    <form asp-action="CreateProduct" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="All" class="text-danger small mb-3"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="ProductName" class="form-label fw-semibold">Product Name</label>
                <input asp-for="ProductName" class="form-control rounded-pill" placeholder="Enter product name" />
                <span asp-validation-for="ProductName" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="CategoryId" class="form-label fw-semibold">Category</label>
                <select asp-for="CategoryId" class="form-select rounded-pill" asp-items="@(new SelectList(ViewBag.Categories, "CategoryId", "CategoryName"))">
                    <option value="">-- Select Category --</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Price" class="form-label fw-semibold">Price</label>
                <input asp-for="Price" class="form-control rounded-pill" placeholder="0.00" type="number" step="0.01" min="0.01" />
                <span asp-validation-for="Price" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="StockQuantity" class="form-label fw-semibold">Stock</label>
                <input asp-for="StockQuantity" class="form-control rounded-pill" placeholder="0" type="number" min="0" max="9999" step="1" />
                <span asp-validation-for="StockQuantity" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label fw-semibold">Description</label>
                <textarea asp-for="Description" class="form-control rounded-4" rows="3" placeholder="Enter description"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold">Main Image</label>
                <input type="file" name="imageFile" class="form-control rounded-pill" accept="image/*" />
            </div>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-orange rounded-pill px-4 fw-bold">
                <i class="fa-solid fa-plus me-1"></i> Create Product
            </button>
            <a asp-action="Products" class="btn btn-outline-admin rounded-pill px-4">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
