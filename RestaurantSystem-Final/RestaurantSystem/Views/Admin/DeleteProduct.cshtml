@model Product
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Delete Product";
    ViewBag.ActiveMenu = "Products";
}

<div class="admin-page-header">
    <div>
        <h2>Delete Product</h2>
        <span class="text-muted small">Remove this item from the menu</span>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 p-4">
    <div class="alert alert-danger rounded-4">
        <h5 class="fw-bold"><i class="fa-solid fa-triangle-exclamation me-2"></i>Are you sure you want to delete this product?</h5>
        <p class="mb-0">This action cannot be undone.</p>
    </div>

    <dl class="row mb-4">
        <dt class="col-sm-2">ID</dt>
        <dd class="col-sm-10">@Model.ProductId</dd>
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10 fw-semibold">@Model.ProductName</dd>
        <dt class="col-sm-2">Category</dt>
        <dd class="col-sm-10">@Model.Category?.CategoryName</dd>
        <dt class="col-sm-2">Price</dt>
        <dd class="col-sm-10">RM @Model.Price.ToString("F2")</dd>
        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@(Model.Description ?? "-")</dd>
        <dt class="col-sm-2">Image</dt>
        <dd class="col-sm-10">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="Main image" class="rounded-3" style="max-height:100px;" />
            }
            else
            {
                <span class="text-muted">No image</span>
            }
        </dd>
    </dl>

    <form asp-action="DeleteProduct" asp-route-id="@Model.ProductId" method="post">
        <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">
            <i class="fa-solid fa-trash me-1"></i> Delete
        </button>
        <a asp-action="Products" class="btn btn-outline-admin rounded-pill px-4">Cancel</a>
    </form>
</div>
