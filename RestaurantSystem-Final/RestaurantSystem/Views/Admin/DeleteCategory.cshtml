@model Category
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Delete Category";
    ViewBag.ActiveMenu = "Categories";
}

<div class="admin-page-header">
    <div>
        <h2>Delete Category</h2>
        <span class="text-muted small">Remove this category</span>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 p-4">
    <div class="alert alert-danger rounded-4">
        <h5 class="fw-bold"><i class="fa-solid fa-triangle-exclamation me-2"></i>Are you sure you want to delete this category?</h5>
        <p class="mb-0">This action cannot be undone.</p>
    </div>

    @if (ViewBag.HasProducts)
    {
        <div class="alert alert-warning rounded-4">
            <i class="fa-solid fa-circle-exclamation me-2"></i>
            <strong>Warning:</strong> This category has products assigned. You cannot delete it until all products are reassigned or removed.
        </div>
    }

    <dl class="row mb-4">
        <dt class="col-sm-2">ID</dt>
        <dd class="col-sm-10">@Model.CategoryId</dd>
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10 fw-semibold">@Model.CategoryName</dd>
    </dl>

    <form asp-action="DeleteCategory" asp-route-id="@Model.CategoryId" method="post">
        @if (!ViewBag.HasProducts)
        {
            <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">
                <i class="fa-solid fa-trash me-1"></i> Delete
            </button>
        }
        <a asp-action="Categories" class="btn btn-outline-admin rounded-pill px-4">Cancel</a>
    </form>
</div>
