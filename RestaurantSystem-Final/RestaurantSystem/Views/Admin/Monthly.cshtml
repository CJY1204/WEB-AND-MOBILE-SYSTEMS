@model MonthlyReportVM
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "Monthly Sales Report";
    ViewBag.ActiveMenu = "ReportMonthly";
    DateTime prev = (DateTime)ViewBag.PrevMonth;
    DateTime next = (DateTime)ViewBag.NextMonth;
    DateTime today = (DateTime)ViewBag.Today;
}

<div class="admin-page-header">
    <div>
        <h2>Monthly Sales Report</h2>
        <span class="text-muted small">@Model.MonthName</span>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Monthly" asp-route-year="@prev.Year" asp-route-month="@prev.Month" class="btn btn-outline-admin rounded-pill">&larr; Prev</a>
        <form method="get" asp-action="Monthly" class="d-flex align-items-center gap-2">
            <input type="number" name="year" value="@Model.Year" min="2000" max="2100" class="form-control rounded-pill" style="width:110px;" />
            <select name="month" class="form-select rounded-pill" style="width:160px;">
                @for (int i = 1; i <= 12; i++)
                {
                    <option value="@i" selected="@(i == Model.Month)">@(new DateTime(2000, i, 1).ToString("MMMM"))</option>
                }
            </select>
            <button type="submit" class="btn btn-admin rounded-pill px-3 fw-bold">View</button>
        </form>
        <a asp-action="Monthly" asp-route-year="@today.Year" asp-route-month="@today.Month" class="btn btn-outline-secondary rounded-pill">This Month</a>
        <a asp-action="Monthly" asp-route-year="@next.Year" asp-route-month="@next.Month" class="btn btn-outline-admin rounded-pill">Next &rarr;</a>
        <a asp-action="ExportMonthlyPdf" asp-route-year="@Model.Year" asp-route-month="@Model.Month" class="btn btn-danger rounded-pill px-4 fw-bold">
            <i class="fa-solid fa-file-pdf me-1"></i> Export PDF
        </a>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-6 mb-3">
        <div class="card border-0 shadow-sm rounded-4 p-4 text-white bg-dark">
            <h6 class="text-uppercase opacity-75">Total Revenue</h6>
            <h2 class="display-6 fw-bold">RM @Model.TotalRevenue.ToString("N2")</h2>
            <small class="opacity-75">@Model.MonthName</small>
        </div>
    </div>
    <div class="col-md-6 mb-3">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-light text-dark">
            <h6 class="text-uppercase text-muted">Total Orders</h6>
            <h2 class="display-6 fw-bold text-orange">@Model.TotalOrders</h2>
            <small class="text-muted">Across @Model.DailySummaries.Count active days</small>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden admin-table-card mb-4">
    <div class="p-4 pb-0">
        <h4 class="fw-bold">Daily Breakdown</h4>
    </div>
    @if (Model.DailySummaries.Count == 0)
    {
        <div class="p-4">
            <div class="alert alert-info rounded-4">No sales recorded for this month.</div>
        </div>
    }
    else
    {
        decimal maxRev = Model.DailySummaries.Max(x => x.Revenue);
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Day</th>
                        <th class="text-center">Orders</th>
                        <th>Revenue</th>
                        <th style="width:30%;">Trend</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.DailySummaries)
                    {
                        decimal pct = maxRev > 0 ? d.Revenue / maxRev * 100 : 0;
                        <tr>
                            <td class="fw-semibold">@d.Day.ToString("dddd, MMM dd")</td>
                            <td class="text-center">@d.Orders</td>
                            <td class="fw-semibold">RM @d.Revenue.ToString("N2")</td>
                            <td>
                                <div class="progress rounded-pill" style="height:10px;">
                                    <div class="progress-bar bg-success" style="width:@pct.ToString("0")%"></div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden admin-table-card">
    <div class="p-4 pb-0">
        <h4 class="fw-bold">Top 10 Items</h4>
    </div>
    @if (Model.TopItems.Count == 0)
    {
        <div class="p-4">
            <div class="alert alert-info rounded-4">No items sold this month.</div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Product</th>
                        <th class="text-center">Quantity</th>
                        <th class="text-end">Revenue</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.TopItems.Count; i++)
                    {
                        var item = Model.TopItems[i];
                        <tr>
                            <td class="text-muted">@(i + 1)</td>
                            <td class="fw-semibold">@item.ProductName</td>
                            <td class="text-center fw-bold">@item.Quantity</td>
                            <td class="text-end">RM @item.Revenue.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
