@{
    Layout = "_Layout";
}
<link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

<div class="container-fluid py-4">
    <div class="row g-4">
        <div class="col-lg-3 col-xl-2">
            <partial name="~/Views/Admin/_Sidebar.cshtml" />
        </div>
        <div class="col-lg-9 col-xl-10">
            @if (TempData["Info"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm">
                    <i class="fa-solid fa-circle-check me-2"></i>@TempData["Info"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </div>
    </div>
</div>

@await RenderSectionAsync("Scripts", required: false)
