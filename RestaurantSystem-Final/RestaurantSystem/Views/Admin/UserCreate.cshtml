@model RestaurantSystem.Models.ViewModels.UserVM
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Create New User";
    ViewBag.ActiveMenu = "UserManage";
}

<div class="admin-page-header">
    <div>
        <h2>Create New User</h2>
        <span class="text-muted small">Add a new member or admin account</span>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 p-4">
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

    <form asp-action="UserCreate" method="post">
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Username" class="form-label fw-semibold">Username</label>
                <input asp-for="Username" class="form-control rounded-pill" placeholder="Enter username" />
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="FullName" class="form-label fw-semibold">Full Name</label>
                <input asp-for="FullName" class="form-control rounded-pill" placeholder="Enter full name" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Email" class="form-label fw-semibold">Email Address</label>
                <input asp-for="Email" class="form-control rounded-pill" placeholder="example@email.com" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="PhoneNumber" class="form-label fw-semibold">Phone Number</label>
                <input asp-for="PhoneNumber" class="form-control rounded-pill" placeholder="e.g. +60123456789" />
                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Address" class="form-label fw-semibold">Address</label>
                <textarea asp-for="Address" class="form-control" rows="2" placeholder="Enter address (optional)"></textarea>
                <span asp-validation-for="Address" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Password" class="form-label fw-semibold">Password</label>
                <input asp-for="Password" class="form-control rounded-pill" placeholder="At least 6 characters" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Role" class="form-label fw-semibold">Role</label>
                <select asp-for="Role" class="form-select rounded-pill">
                    <option value="MEMBER">Member</option>
                    <option value="ADMIN">Admin</option>
                </select>
                <span asp-validation-for="Role" class="text-danger small"></span>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-orange rounded-pill px-4 fw-bold">
                <i class="fa-solid fa-user-plus me-1"></i> Create User
            </button>
            <a asp-action="UserManage" class="btn btn-outline-admin rounded-pill px-4">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
