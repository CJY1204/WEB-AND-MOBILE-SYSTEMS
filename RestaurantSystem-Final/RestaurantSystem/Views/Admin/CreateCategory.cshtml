@model Category
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Create Category";
    ViewBag.ActiveMenu = "Categories";
}

<div class="admin-page-header">
    <div>
        <h2>Create Category</h2>
        <span class="text-muted small">Add a new menu category</span>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 p-4">
    <form asp-action="CreateCategory" method="post">
        <div class="mb-3">
            <label asp-for="CategoryName" class="form-label fw-semibold">Category Name</label>
            <input asp-for="CategoryName" class="form-control rounded-pill" placeholder="Enter category name" />
            <span asp-validation-for="CategoryName" class="text-danger small"></span>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-orange rounded-pill px-4 fw-bold">
                <i class="fa-solid fa-plus me-1"></i> Create Category
            </button>
            <a asp-action="Categories" class="btn btn-outline-admin rounded-pill px-4">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
