@model RestaurantSystem.Models.ViewModels.PasswordRecoveryResetVM
@{
    ViewData["Title"] = "Reset Your Password";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm border-0 rounded-4 p-4">
                <h3 class="fw-bold text-center mb-1">Set a New Password</h3>
                <p class="text-muted text-center small mb-4">You're resetting the password for <strong>@Model.Email</strong>.</p>

                <form asp-action="PasswordRecoveryReset" asp-controller="Account" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <input type="hidden" asp-for="Token" />
                    <input type="hidden" asp-for="Email" />

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-semibold">New Password</label>
                        <input asp-for="NewPassword" class="form-control rounded-pill" placeholder="At least 6 characters" />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmNewPassword" class="form-label fw-semibold">Confirm New Password</label>
                        <input asp-for="ConfirmNewPassword" class="form-control rounded-pill" placeholder="Re-enter new password" />
                        <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-orange w-100 rounded-pill py-2 fw-bold">Reset Password</button>
                </form>

                <div class="text-center mt-3">
                    <a asp-action="Login" asp-controller="Account" class="text-orange text-decoration-none small">Back to Login</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
