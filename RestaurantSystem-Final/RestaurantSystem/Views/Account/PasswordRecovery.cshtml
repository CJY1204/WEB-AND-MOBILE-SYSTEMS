@model RestaurantSystem.Models.ViewModels.PasswordRecoveryVM
@{
    ViewData["Title"] = "Password Recovery";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm border-0 rounded-4 p-4">
                <h3 class="fw-bold text-center mb-1">Password Recovery</h3>
                <p class="text-muted text-center small mb-4">Enter the email address linked to your account. We'll send you a link to reset your password.</p>

                @if (ViewBag.Info != null)
                {
                    <div class="alert alert-success small mb-4" role="alert">
                        <i class="fa-solid fa-circle-check me-1"></i> @ViewBag.Info
                    </div>
                }

                <form asp-action="PasswordRecovery" asp-controller="Account" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label fw-semibold">Email Address</label>
                        <input asp-for="Email" class="form-control rounded-pill" placeholder="you@example.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-orange w-100 rounded-pill py-2 fw-bold">Send Reset Link</button>
                </form>

                <div class="text-center mt-3">
                    <a asp-action="Login" asp-controller="Account" class="text-orange text-decoration-none small">Back to Login</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
