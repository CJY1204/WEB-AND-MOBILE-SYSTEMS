@model RestaurantSystem.Models.ViewModels.PaymentVM
@{
    ViewData["Title"] = "Payment";
}

<div class="container my-5">
    <h2 class="mb-4"><i class="fa-solid fa-credit-card me-2"></i>Payment</h2>

    <div class="row">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold">Order Summary</h5>
                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">
                        @(Model.DiningOption == "DineIn" ? $"Dine-in · {Model.TableName}" : "Takeaway")
                    </span>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Dish</th>
                                <th class="text-center">Qty</th>
                                <th class="text-end pe-4">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.CartItems)
                            {
                                <tr>
                                    <td class="ps-4">@item.ProductName</td>
                                    <td class="text-center">@item.Quantity</td>
                                    <td class="text-end pe-4">RM @item.Total.ToString("F2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="table-light">
                                <td class="ps-4 fw-bold" colspan="2">Grand Total</td>
                                <td class="text-end pe-4 fw-bold text-success fs-5">RM @Model.GrandTotal.ToString("F2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
            <a asp-action="Checkout" asp-controller="Order" class="btn btn-outline-secondary">
                <i class="fa-solid fa-arrow-left me-2"></i>Back to Takeaway / Dine-in
            </a>
        </div>

        <div class="col-lg-5">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold">Select Payment Method</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="PlaceOrder" asp-controller="Order" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="list-group mb-4">
                            <label class="list-group-item d-flex gap-3 align-items-center">
                                <input class="form-check-input" type="radio" name="PaymentMethod" value="Cash" checked>
                                <i class="fa-solid fa-money-bill-wave text-success fs-4"></i>
                                <span class="fw-bold">Cash </span>
                            </label>
                            <label class="list-group-item d-flex gap-3 align-items-center">
                                <input class="form-check-input" type="radio" name="PaymentMethod" value="Card">
                                <i class="fa-regular fa-credit-card text-primary fs-4"></i>
                                <span class="fw-bold">Credit / Debit Card </span>
                            </label>
                            <label class="list-group-item d-flex gap-3 align-items-center">
                                <input class="form-check-input" type="radio" name="PaymentMethod" value="EWallet">
                                <i class="fa-solid fa-wallet text-orange fs-4"></i>
                                <span class="fw-bold">E-Wallet / Online </span>
                            </label>
                        </div>

                        <button type="submit" class="btn btn-orange btn-lg w-100 fw-bold">
                            <i class="fa-solid fa-lock me-2"></i>Confirm &amp; Pay RM @Model.GrandTotal.ToString("F2")
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
