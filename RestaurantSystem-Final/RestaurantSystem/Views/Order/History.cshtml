@model List<RestaurantSystem.Models.ViewModels.OrderSummaryVM>
@{
    ViewData["Title"] = "My Orders";
    string current = ViewBag.CurrentStatus ?? "ALL";

    (string cls, string label) StatusBadge(string status) => status switch
    {
        "PENDING" => ("bg-warning text-dark", "Pending"),
        "COMPLETED" => ("bg-success", "Completed"),
        "CANCELLED" => ("bg-secondary", "Cancelled"),
        _ => ("bg-light text-dark", status)
    };

    string TabClass(string status) => current == status ? "nav-link active fw-bold" : "nav-link fw-bold";
}

<div class="container my-5">
    <h2 class="mb-4"><i class="fa-solid fa-clock-rotate-left me-2"></i>My Orders</h2>

    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-circle-info me-2"></i>@TempData["Info"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <ul class="nav nav-pills mb-4">
        <li class="nav-item"><a class="@TabClass("ALL")" asp-action="History" asp-route-status="ALL">All</a></li>
        <li class="nav-item"><a class="@TabClass("PENDING")" asp-action="History" asp-route-status="PENDING">Pending</a></li>
        <li class="nav-item"><a class="@TabClass("COMPLETED")" asp-action="History" asp-route-status="COMPLETED">Completed</a></li>
        <li class="nav-item"><a class="@TabClass("CANCELLED")" asp-action="History" asp-route-status="CANCELLED">Cancelled</a></li>
    </ul>

    @if (Model == null || !Model.Any())
    {
        <div class="card text-center p-5 shadow-sm border-0">
            <i class="fa-solid fa-receipt text-muted mb-3" style="font-size: 3rem;"></i>
            <h5 class="text-secondary">No orders found in this category.</h5>
            <a asp-controller="Home" asp-action="Menu" class="btn btn-orange mt-3 mx-auto px-4 fw-bold" style="width: fit-content;">Browse Menu</a>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Order #</th>
                            <th>Date</th>
                            <th>Dining</th>
                            <th class="text-center">Items</th>
                            <th class="text-end">Total</th>
                            <th class="text-center">Status</th>
                            <th class="text-end pe-4">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            var (badgeCls, badgeLabel) = StatusBadge(order.Status);
                            <tr>
                                <td class="ps-4 fw-bold">#@order.OrderId</td>
                                <td>@order.OrderDate.ToString("dd MMM yyyy, HH:mm")</td>
                                <td>
                                    @(order.DiningOption == "DineIn" ? $"Dine-in · {order.TableName}" : "Takeaway")
                                    @if (order.DiningOption == "DineIn" && order.TableStillOccupied)
                                    {
                                        <form asp-action="CheckOutTable" asp-route-orderId="@order.OrderId" method="post" class="d-inline ms-2"
                                              onsubmit="return confirm('Check out this table? Only do this once you have finished dining.');">
                                            <button type="submit" class="btn btn-sm btn-outline-success">
                                                <i class="fa-solid fa-door-open"></i> Check Out Table
                                            </button>
                                        </form>
                                    }
                                </td>
                                <td class="text-center">@order.Items.Sum(i => i.Quantity)</td>
                                <td class="text-end">RM @order.TotalAmount.ToString("F2")</td>
                                <td class="text-center"><span class="badge @badgeCls px-3 py-2 rounded-pill">@badgeLabel</span></td>
                                <td class="text-end pe-4">
                                    <a asp-action="Details" asp-route-id="@order.OrderId" class="btn btn-sm btn-outline-secondary">
                                        <i class="fa-solid fa-eye"></i> View
                                    </a>
                                    @if (order.CanCancel)
                                    {
                                        <form asp-action="Cancel" asp-route-id="@order.OrderId" method="post" class="d-inline"
                                              onsubmit="return confirm('Cancel this order?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger ms-1">
                                                <i class="fa-solid fa-ban"></i> Cancel
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
