@model IEnumerable<RestaurantSystem.Models.Table>
@{
    ViewData["Title"] = "Live Table Status";
}
<link rel="stylesheet" href="~/css/tables.css" asp-append-version="true" />

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-1">Live Table Status Overview</h2>
            <p class="text-muted small mb-0">Real-time table status powered by SQL Server database.</p>
        </div>
        <div class="d-flex gap-3">
            <span class="badge bg-success px-3 py-2 rounded-pill shadow-sm">Available</span>
            <span class="badge bg-danger px-3 py-2 rounded-pill shadow-sm">Occupied</span>
        </div>
    </div>

    <div class="row row-cols-2 row-cols-md-5 g-4" id="tables-container">
        @if (Model != null && Model.Any())
        {
            foreach (var table in Model)
            {
                <div class="col">
                    <div id="table-card-@table.TableId" class="card h-100 shadow-sm text-center p-4 table-card @(table.IsOccupied ? "status-occupied" : "status-available")">
                        <div class="fs-1 mb-2">
                            <i class="fa-solid fa-table"></i>
                        </div>
                        <h4 class="fw-bold mb-1">@table.TableName</h4>

                        <span class="fw-bold small text-uppercase">
                            @(table.IsOccupied ? "Occupied" : "Available")
                        </span>

                        @if (table.IsOccupied && User.Identity?.IsAuthenticated == true && User.IsInRole("ADMIN"))
                        {
                            <form asp-action="AdminFreeTable" asp-controller="Home" method="post" class="mt-3"
                                  onsubmit="return confirm('Mark @table.TableName as available? Only do this once the table has actually been cleared.');">
                                <input type="hidden" name="tableId" value="@table.TableId" />
                                <button type="submit" class="btn btn-sm btn-outline-success rounded-pill w-100">
                                    <i class="fa-solid fa-door-open me-1"></i>Free Table
                                </button>
                            </form>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <p class="text-muted fs-5">No tables found in database.</p>
            </div>
        }
    </div>
</div>
