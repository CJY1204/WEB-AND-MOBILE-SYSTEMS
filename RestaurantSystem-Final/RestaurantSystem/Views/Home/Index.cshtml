@model List<RestaurantSystem.Models.ViewModels.TopSellingItemVM>
@{
    ViewData["Title"] = "Home Page";

    // Badge color per category (category NAME comes straight from the DB via the join in HomeController)
    string GetBadgeColor(int categoryId) => categoryId switch
    {
        1 => "bg-warning",
        2 => "bg-danger",
        3 => "bg-info",
        _ => "bg-success"
    };
}
<link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />

<div class="position-relative overflow-hidden rounded-5 shadow my-4 hero-bg-section">

    <div class="position-absolute top-0 start-0 w-100 h-100 hero-overlay"></div>

    <div class="container position-relative h-100 d-flex align-items-center justify-content-center text-center py-5 glass-content-box">
        <div class="row justify-content-center w-100">
            <div class="col-md-8 text-white p-5 rounded-4">
                <h1 class="display-4 fw-bold mb-3">Enjoy a Smart & Modern <span style="color:#ff9f43">Dining Experience</span></h1>
                <p class="lead mb-4 opacity-90">Welcome to BITE Premium Food Hub. Select your table, browse our freshly crafted menu, and order seamlessly with just a few taps.</p>

                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Menu" class="btn btn-orange btn-lg rounded-pill px-5 shadow fw-bold">
                        <i class="fa-solid fa-utensils me-2"></i> Order Now
                    </a>
                    @if (User.Identity?.IsAuthenticated != true)
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light btn-lg rounded-pill px-5 fw-bold">
                            Login
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="my-5">
    <h3 class="fw-bold text-center mb-4 text-dark">
        @(Model != null && Model.Any() ? "Our Top Selling Picks" : "Explore Our Top Picks")
    </h3>

    <div id="foodBannerCarousel" class="carousel slide shadow rounded-4 overflow-hidden" data-bs-ride="carousel" data-bs-interval="10000">
        <div class="carousel-inner carousel-banner-inner">

            @if (Model != null && Model.Any())
            {
                // Real top-selling products, ranked by total quantity sold
                for (int i = 0; i < Model.Count; i++)
                {
                    var item = Model[i];
                    <div class="carousel-item @(i == 0 ? "active" : "") h-100" style="background: url('@item.ImageUrl') center/cover no-repeat;">
                        <div class="w-100 h-100 d-flex align-items-end carousel-text-gradient">
                            <div class="p-4 text-white">
                                <span class="badge @GetBadgeColor(item.CategoryId) mb-2">@item.CategoryName</span>
                                <h4 class="fw-bold mb-1">@item.ProductName</h4>
                                <p class="small mb-0 opacity-75"><i class="fa-solid fa-fire me-1"></i>@item.TotalSold sold</p>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <!-- No sales data yet (e.g. Checkout isn't live yet) — show default featured picks instead -->
                <div class="carousel-item active h-100" style="background: url('/images/burger.jpg') center/cover no-repeat;">
                    <div class="w-100 h-100 d-flex align-items-end carousel-text-gradient">
                        <div class="p-4 text-white">
                            <span class="badge bg-warning mb-2">Main Course</span>
                            <h4 class="fw-bold">Premium Classic Beef Burger</h4>
                        </div>
                    </div>
                </div>

                <div class="carousel-item h-100" style="background: url('/images/fries.jpg') center/cover no-repeat;">
                    <div class="w-100 h-100 d-flex align-items-end carousel-text-gradient">
                        <div class="p-4 text-white">
                            <span class="badge bg-danger mb-2">Snacks</span>
                            <h4 class="fw-bold">Golden Crispy French Fries</h4>
                        </div>
                    </div>
                </div>

                <div class="carousel-item h-100" style="background: url('/images/milktea.jpg') center/cover no-repeat;">
                    <div class="w-100 h-100 d-flex align-items-end carousel-text-gradient">
                        <div class="p-4 text-white">
                            <span class="badge bg-info mb-2">Drinks</span>
                            <h4 class="fw-bold">Signature Pearl Milk Tea</h4>
                        </div>
                    </div>
                </div>

                <div class="carousel-item h-100" style="background: url('/images/lavacake.jpg') center/cover no-repeat;">
                    <div class="w-100 h-100 d-flex align-items-end carousel-text-gradient">
                        <div class="p-4 text-white">
                            <span class="badge bg-success mb-2">Desserts</span>
                            <h4 class="fw-bold">Decadent Chocolate Lava Cake</h4>
                        </div>
                    </div>
                </div>
            }

        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#foodBannerCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon bg-dark rounded-circle p-3" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#foodBannerCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon bg-dark rounded-circle p-3" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
</div>
