@{
    ViewData["Title"] = "Our Menu";

    bool isAdmin = User.Identity?.IsAuthenticated == true && User.IsInRole("ADMIN");
    bool isMember = User.Identity?.IsAuthenticated == true && !isAdmin;
    string userRole = isAdmin ? "ADMIN" : (isMember ? "MEMBER" : "GUEST");
}
<link rel="stylesheet" href="~/css/menu.css" asp-append-version="true" />

<div class="container py-4">
    <div class="row">

        <div class="col-md-3 mb-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 sticky-top sticky-sidebar" style="top: 20px; z-index: 1020;">
                <h5 class="fw-bold mb-3 px-2 text-muted">Categories</h5>
                <div class="nav flex-column nav-pills" id="category-filter">
                    <button type="button" class="nav-link active text-start py-3 rounded-3 mb-2 fw-bold category-pill" data-category="0">ALL PRODUCTS</button>
                    <button type="button" class="nav-link text-start py-3 rounded-3 mb-2 fw-bold category-pill" data-category="1">Main Course</button>
                    <button type="button" class="nav-link text-start py-3 rounded-3 mb-2 fw-bold category-pill" data-category="2">Snacks</button>
                    <button type="button" class="nav-link text-start py-3 rounded-3 mb-2 fw-bold category-pill" data-category="3">Drinks</button>
                    <button type="button" class="nav-link text-start py-3 rounded-3 mb-2 fw-bold category-pill" data-category="4">Desserts</button>
                </div>

                <hr class="my-3" />

                <h5 class="fw-bold mb-3 px-2 text-muted">Price Range (RM)</h5>
                <div class="px-2">
                    <div class="d-flex gap-2 align-items-center mb-2">
                        <input type="number" id="price-min" class="form-control form-control-sm rounded-pill" placeholder="Min" min="0" step="0.5" />
                        <span class="text-muted">–</span>
                        <input type="number" id="price-max" class="form-control form-control-sm rounded-pill" placeholder="Max" min="0" step="0.5" />
                    </div>
                    <button type="button" id="filters-reset-btn" class="btn btn-sm btn-outline-secondary w-100 rounded-pill">Reset All Filters</button>
                </div>
            </div>
        </div>

        <div class="col-md-9">
            <div class="d-flex flex-wrap gap-2 align-items-center mb-4">
                <div class="flex-grow-1 position-relative">
                    <i class="fa-solid fa-magnifying-glass position-absolute text-muted" style="left: 16px; top: 50%; transform: translateY(-50%);"></i>
                    <input type="text" id="search-input" class="form-control rounded-pill ps-5" placeholder="Search for a dish..." />
                </div>

                <select id="sort-select" class="form-select rounded-pill" style="width: auto;">
                    <option value="name_asc">Name (A–Z)</option>
                    <option value="name_desc">Name (Z–A)</option>
                    <option value="price_asc">Price (Low to High)</option>
                    <option value="price_desc">Price (High to Low)</option>
                </select>
            </div>

            <div id="results-summary" class="text-muted small mb-3"></div>

            <div id="product-grid" class="row"></div>

            <nav id="pagination-container" class="mt-4"></nav>
        </div>

    </div>
</div>

<style>
    .local-toast {
        position: fixed;
        bottom: 30px;
        right: 30px;
        background: rgba(30, 41, 59, 0.95);
        color: #ffffff;
        padding: 14px 24px;
        border-radius: 12px;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3), 0 8px 10px -6px rgba(0, 0, 0, 0.3);
        font-size: 14px;
        font-weight: 600;
        z-index: 99999;
        display: flex;
        align-items: center;
        gap: 10px;
        pointer-events: none;
        opacity: 0;
        transform: translateY(20px) scale(0.95);
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

        .local-toast.show {
            opacity: 1;
            transform: translateY(0) scale(1);
        }

        .local-toast::before {
            content: "✓";
            display: inline-flex;
            justify-content: center;
            align-items: center;
            width: 20px;
            height: 20px;
            background: #10B981;
            color: white;
            border-radius: 50%;
            font-size: 11px;
            font-weight: bold;
        }

    .badge-bounce {
        animation: badgeBounce 0.4s ease;
    }

    @@keyframes badgeBounce {
        0% {
            transform: translate(-50%, -50%) scale(1);
        }

        50% {
            transform: translate(-50%, -50%) scale(1.4);
        }

        100% {
            transform: translate(-50%, -50%) scale(1);
        }
    }

    .btn-pop {
        animation: btnPop 0.3s ease;
    }

    @@keyframes btnPop {
        0% {
            transform: scale(1);
        }

        50% {
            transform: scale(0.94);
        }

        100% {
            transform: scale(1);
        }
    }

    #product-grid {
        min-height: 200px;
    }

    .catalog-spinner {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 60px 0;
        width: 100%;
    }
</style>

<script>
    const userRole = "@userRole"; // "ADMIN" | "MEMBER" | "GUEST" — fixed for the whole page load

    document.addEventListener("DOMContentLoaded", function() {

        const state = {
            search: "",
            categoryId: 0,
            minPrice: null,
            maxPrice: null,
            sortBy: "name_asc",
            page: 1
        };

        const grid = document.getElementById("product-grid");
        const paginationContainer = document.getElementById("pagination-container");
        const resultsSummary = document.getElementById("results-summary");
        const searchInput = document.getElementById("search-input");
        const sortSelect = document.getElementById("sort-select");
        const priceMinInput = document.getElementById("price-min");
        const priceMaxInput = document.getElementById("price-max");
        const resetBtn = document.getElementById("filters-reset-btn");

        let searchDebounceTimer = null;
        let priceDebounceTimer = null;

        // ---------- Toast helper (shared pattern used across the app) ----------
        function showLocalToast(message) {
            const oldToast = document.querySelector(".local-toast");
            if (oldToast) oldToast.remove();

            const toast = document.createElement("div");
            toast.className = "local-toast";
            toast.innerText = message;
            document.body.appendChild(toast);

            setTimeout(() => toast.classList.add("show"), 50);
            setTimeout(() => {
                toast.classList.remove("show");
                setTimeout(() => toast.remove(), 300);
            }, 2500);
        }

        function bounceBadge(id, value) {
            const badge = document.getElementById(id);
            if (badge) {
                badge.innerText = value;
                badge.classList.remove("badge-bounce");
                void badge.offsetWidth;
                badge.classList.add("badge-bounce");
            }
        }

        // ---------- Badge color per category (mirrors the server-side mapping) ----------
        function getBadgeColor(categoryId) {
            switch (categoryId) {
                case 1: return "bg-warning text-dark";
                case 2: return "bg-danger";
                case 3: return "bg-info text-dark";
                default: return "bg-success";
            }
        }

        // ---------- Build a single product card's HTML ----------
        function buildCard(p) {
            let actionHtml = "";
            const outOfStock = p.stockQuantity <= 0;

            if (userRole === "ADMIN") {
                actionHtml = `
                        <a href="/Admin/EditProduct/${p.productId}" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-bold w-100">Manage Item</a>
                    `;
            } else if (userRole === "MEMBER") {
                const favClass = p.isFavorited ? "btn-danger in-favorite" : "btn-outline-secondary";
                const favLabel = p.isFavorited ? "Added to Favorites" : "Add to Favorite";
                const favDisabled = p.isFavorited ? "disabled" : "";

                const cartButtonHtml = outOfStock
                    ? `<button type="button" class="btn btn-sm btn-secondary rounded-pill fw-bold w-100" disabled>Out of Stock</button>`
                    : `<form class="add-to-cart-form" data-product-id="${p.productId}">
                               <button type="submit" class="btn btn-sm btn-orange rounded-pill fw-bold w-100">Add to Cart</button>
                           </form>`;

                actionHtml = `
                        <div class="d-grid gap-2">
                            ${cartButtonHtml}
                            <button type="button"
                                    class="btn btn-sm rounded-pill fw-bold w-100 add-to-favorite-btn ${favClass}"
                                    data-product-id="${p.productId}"
                                    ${favDisabled}>
                                <i class="fa-solid fa-heart me-1"></i>
                                <span class="fav-btn-label">${favLabel}</span>
                            </button>
                        </div>
                    `;
            } else {
                actionHtml = `<a href="/Account/Login" class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-bold w-100">Login to Order</a>`;
            }

            let stockNoticeHtml = "";
            if (outOfStock) {
                stockNoticeHtml = `<div class="small text-danger fw-bold mb-1"><i class="fa-solid fa-circle-exclamation me-1"></i>Out of Stock</div>`;
            } else if (p.stockQuantity <= 10) {
                stockNoticeHtml = `<div class="small text-warning fw-bold mb-1"><i class="fa-solid fa-triangle-exclamation me-1"></i>Only ${p.stockQuantity} left!</div>`;
            }

            return `
                    <div class="col-md-4 mb-4">
                        <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden position-relative">
                            <span class="badge ${getBadgeColor(p.categoryId)} position-absolute top-0 end-0 m-3 px-3 py-2 rounded-pill shadow-sm product-badge">${p.categoryName}</span>

                            <a href="/Home/ProductDetail/${p.productId}" class="text-decoration-none text-dark">
                                <img src="${p.imageUrl}" class="card-img-top product-card-img" alt="${p.productName}">
                            </a>

                            <div class="card-body d-flex flex-column justify-content-between">
                                <div>
                                    <a href="/Home/ProductDetail/${p.productId}" class="text-decoration-none text-dark">
                                        <h5 class="fw-bold mb-1">${p.productName}</h5>
                                    </a>
                                    <p class="text-muted small mb-3">${p.description ?? ""}</p>
                                </div>

                                <div class="mt-2">
                                    ${stockNoticeHtml}
                                    <div class="mb-2">
                                        <span class="fw-bold text-orange fs-5">RM ${p.price.toFixed(2)}</span>
                                    </div>
                                    ${actionHtml}
                                </div>
                            </div>
                        </div>
                    </div>
                `;
        }

        // ---------- Pagination controls ----------
        function buildPagination(totalPages, currentPage) {
            if (totalPages <= 1) {
                paginationContainer.innerHTML = "";
                return;
            }

            let html = `<ul class="pagination justify-content-center">`;

            html += `<li class="page-item ${currentPage === 1 ? "disabled" : ""}">
                            <button type="button" class="page-link page-btn" data-page="${currentPage - 1}">Previous</button>
                          </li>`;

            for (let i = 1; i <= totalPages; i++) {
                html += `<li class="page-item ${i === currentPage ? "active" : ""}">
                                <button type="button" class="page-link page-btn" data-page="${i}">${i}</button>
                              </li>`;
            }

            html += `<li class="page-item ${currentPage === totalPages ? "disabled" : ""}">
                            <button type="button" class="page-link page-btn" data-page="${currentPage + 1}">Next</button>
                          </li>`;

            html += `</ul>`;
            paginationContainer.innerHTML = html;
        }

        // ---------- The single AJAX call everything funnels through ----------
        function loadProducts() {
            grid.innerHTML = `
                    <div class="catalog-spinner">
                        <div class="spinner-border text-warning" role="status"><span class="visually-hidden">Loading...</span></div>
                    </div>
                `;

            const params = new URLSearchParams();
            if (state.search) params.set("search", state.search);
            if (state.categoryId > 0) params.set("categoryId", state.categoryId);
            if (state.minPrice !== null && state.minPrice !== "") params.set("minPrice", state.minPrice);
            if (state.maxPrice !== null && state.maxPrice !== "") params.set("maxPrice", state.maxPrice);
            params.set("sortBy", state.sortBy);
            params.set("page", state.page);

            fetch("/Home/SearchProducts?" + params.toString())
                .then(response => response.json())
                .then(data => {
                    if (!data.products || data.products.length === 0) {
                        grid.innerHTML = `<div class="col-12 text-center py-5"><p class="text-muted fs-5">No dishes match your search.</p></div>`;
                        resultsSummary.innerText = "0 results";
                    } else {
                        grid.innerHTML = data.products.map(buildCard).join("");
                        resultsSummary.innerText = `${data.totalCount} dish${data.totalCount === 1 ? "" : "es"} found`;
                    }

                    state.page = data.currentPage;
                    buildPagination(data.totalPages, data.currentPage);
                })
                .catch(err => {
                    console.error("AJAX error:", err);
                    grid.innerHTML = `<div class="col-12 text-center py-5"><p class="text-danger">Something went wrong loading the menu. Please try again.</p></div>`;
                });
        }

        // ---------- Filter/sort/search/page event wiring ----------
        searchInput.addEventListener("input", function() {
            clearTimeout(searchDebounceTimer);
            searchDebounceTimer = setTimeout(() => {
                state.search = searchInput.value.trim();
                state.page = 1;
                loadProducts();
            }, 400);
        });

        sortSelect.addEventListener("change", function() {
            state.sortBy = sortSelect.value;
            state.page = 1;
            loadProducts();
        });

        document.querySelectorAll(".category-pill").forEach(pill => {
            pill.addEventListener("click", function() {
                document.querySelectorAll(".category-pill").forEach(p => p.classList.remove("active"));
                this.classList.add("active");
                state.categoryId = parseInt(this.dataset.category, 10);
                state.page = 1;
                loadProducts();
            });
        });

        function onPriceChange() {
            clearTimeout(priceDebounceTimer);
            priceDebounceTimer = setTimeout(() => {
                state.minPrice = priceMinInput.value !== "" ? priceMinInput.value : null;
                state.maxPrice = priceMaxInput.value !== "" ? priceMaxInput.value : null;
                state.page = 1;
                loadProducts();
            }, 400);
        }
        priceMinInput.addEventListener("input", onPriceChange);
        priceMaxInput.addEventListener("input", onPriceChange);

        resetBtn.addEventListener("click", function() {
            state.search = "";
            state.categoryId = 0;
            state.minPrice = null;
            state.maxPrice = null;
            state.sortBy = "name_asc";
            state.page = 1;

            searchInput.value = "";
            priceMinInput.value = "";
            priceMaxInput.value = "";
            sortSelect.value = "name_asc";
            document.querySelectorAll(".category-pill").forEach(p => p.classList.remove("active"));
            document.querySelector('.category-pill[data-category="0"]').classList.add("active");

            loadProducts();
        });

        // Pagination clicks (event delegation, since buttons are re-created each load)
        paginationContainer.addEventListener("click", function(e) {
            const btn = e.target.closest(".page-btn");
            if (!btn || btn.closest(".page-item").classList.contains("disabled")) return;

            const targetPage = parseInt(btn.dataset.page, 10);
            if (isNaN(targetPage) || targetPage < 1) return;

            state.page = targetPage;
            loadProducts();
            window.scrollTo({ top: 0, behavior: "smooth" });
        });

        // ---------- Add to Cart / Add to Favorite (event delegation on the grid) ----------
        grid.addEventListener("submit", function(e) {
            const form = e.target.closest(".add-to-cart-form");
            if (!form) return;
            e.preventDefault();

            const productId = form.dataset.productId;

            fetch("/Home/AddAjax", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: "productId=" + encodeURIComponent(productId)
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        bounceBadge("cart-badge", data.cartCount);
                        showLocalToast(data.cappedToStock
                            ? `${data.productName} added — that's all the stock we have left!`
                            : `${data.productName} added to cart!`);
                    } else {
                        alert("Error: " + data.message);
                    }
                })
                .catch(err => console.error("AJAX error:", err));
        });

        grid.addEventListener("click", function(e) {
            const btn = e.target.closest(".add-to-favorite-btn");
            if (!btn) return;

            const productId = btn.dataset.productId;

            btn.classList.add("btn-pop");
            setTimeout(() => btn.classList.remove("btn-pop"), 300);

            fetch("/Home/AddFavoriteAjax", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: "productId=" + encodeURIComponent(productId)
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        document.querySelectorAll(`.add-to-favorite-btn[data-product-id="${productId}"]`)
                            .forEach(matchingBtn => {
                                matchingBtn.classList.remove("btn-outline-secondary");
                                matchingBtn.classList.add("btn-danger", "in-favorite");
                                matchingBtn.disabled = true;
                                const label = matchingBtn.querySelector(".fav-btn-label");
                                if (label) label.innerText = "Added to Favorites";
                            });

                        bounceBadge("favorite-badge", data.favoriteCount);
                        showLocalToast(`${data.productName} added to favorites!`);
                    } else {
                        showLocalToast(data.message);
                    }
                })
                .catch(err => console.error("AJAX error:", err));
        });

        // Initial load
        loadProducts();
    });
</script>
