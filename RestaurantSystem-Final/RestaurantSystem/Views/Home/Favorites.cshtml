@model List<RestaurantSystem.Models.Product>

@{
    ViewData["Title"] = "My Favorites";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="fa-solid fa-heart text-danger me-2"></i>My Favorites
            <span class="badge bg-secondary" id="favorite-item-count">@(Model?.Count ?? 0) Items</span>
        </h2>

        <button type="button" id="move-all-btn" class="btn btn-orange rounded-pill px-4 fw-bold" style="@(Model == null || !Model.Any() ? "display:none;" : "")">
            <i class="fa-solid fa-cart-plus me-1"></i> Move All to Cart
        </button>
    </div>

    <div id="favorites-empty-state" class="card text-center p-5 shadow-sm" style="@(Model != null && Model.Any() ? "display:none;" : "")">
        <div class="card-body">
            <i class="fa-regular fa-heart text-muted" style="font-size: 4rem;"></i>
            <h4 class="mt-3 text-secondary">You have no favorites yet</h4>
            <p class="text-muted">Tap "Add to Favorite" on any dish in the menu to save it here.</p>
            <a asp-controller="Home" asp-action="Menu" class="btn btn-orange px-4 py-2 mt-2 text-white fw-bold rounded-pill">
                <i class="fa-solid fa-arrow-left me-2"></i>Browse Menu
            </a>
        </div>
    </div>

    <div id="favorites-list" class="row">
        @if (Model != null)
        {
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4 favorite-card" id="favorite-card-@item.ProductId" data-product-id="@item.ProductId">
                    <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden">
                        <img src="@item.ImageUrl" class="card-img-top" style="height: 180px; object-fit: cover;" alt="food">
                        <div class="card-body d-flex flex-column">
                            <h5 class="fw-bold mb-1">@item.ProductName</h5>
                            <p class="fw-bold text-orange fs-5 mb-3">RM @item.Price.ToString("F2")</p>

                            <div class="mt-auto d-flex gap-2">
                                <button type="button" class="btn btn-orange btn-sm w-100 rounded-pill fw-bold move-to-cart-btn" data-product-id="@item.ProductId">
                                    <i class="fa-solid fa-cart-plus me-1"></i>Move to Cart
                                </button>

                                <button type="button" class="btn btn-outline-danger btn-sm rounded-circle d-inline-flex align-items-center justify-content-center flex-shrink-0 remove-favorite-btn"
                                        data-product-id="@item.ProductId"
                                        title="Remove from favorites"
                                        style="width: 38px; height: 38px; padding: 0;">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <a asp-controller="Home" asp-action="Menu" class="btn btn-outline-secondary px-4">
        <i class="fa-solid fa-arrow-left me-2"></i>Browse More Dishes
    </a>
</div>

<style>
    .local-toast {
        position: fixed;
        bottom: 30px;
        right: 30px;
        background: rgba(30, 41, 59, 0.95);
        color: #ffffff;
        padding: 14px 24px;
        border-radius: 12px;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3), 0 8px 10px -6px rgba(0, 0, 0, 0.3);
        font-size: 14px;
        font-weight: 600;
        z-index: 99999;
        display: flex;
        align-items: center;
        gap: 10px;
        pointer-events: none;
        opacity: 0;
        transform: translateY(20px) scale(0.95);
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

        .local-toast.show {
            opacity: 1;
            transform: translateY(0) scale(1);
        }

        .local-toast::before {
            content: "✓";
            display: inline-flex;
            justify-content: center;
            align-items: center;
            width: 20px;
            height: 20px;
            background: #10B981;
            color: white;
            border-radius: 50%;
            font-size: 11px;
            font-weight: bold;
        }

    .badge-bounce {
        animation: badgeBounce 0.4s ease;
    }

    @@keyframes badgeBounce {
        0% {
            transform: translate(-50%, -50%) scale(1);
        }

        50% {
            transform: translate(-50%, -50%) scale(1.4);
        }

        100% {
            transform: translate(-50%, -50%) scale(1);
        }
    }

    .btn-pop {
        animation: btnPop 0.3s ease;
    }

    @@keyframes btnPop {
        0% {
            transform: scale(1);
        }

        50% {
            transform: scale(0.92);
        }

        100% {
            transform: scale(1);
        }
    }

    .favorite-card.removing {
        transition: opacity 0.3s ease, transform 0.3s ease;
        opacity: 0;
        transform: scale(0.9);
        pointer-events: none;
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function() {

        function showLocalToast(message) {
            const oldToast = document.querySelector(".local-toast");
            if (oldToast) oldToast.remove();

            const toast = document.createElement("div");
            toast.className = "local-toast";
            toast.innerText = message;
            document.body.appendChild(toast);

            setTimeout(() => toast.classList.add("show"), 50);
            setTimeout(() => {
                toast.classList.remove("show");
                setTimeout(() => toast.remove(), 300);
            }, 2500);
        }

        function updateCartBadge(cartCount) {
            const badge = document.getElementById("cart-badge");
            if (badge) {
                badge.innerText = cartCount;
                badge.classList.remove("badge-bounce");
                void badge.offsetWidth;
                badge.classList.add("badge-bounce");
            }
        }

        function updateFavoriteBadge(favoriteCount) {
            const badge = document.getElementById("favorite-badge");
            if (badge) {
                badge.innerText = favoriteCount;
                badge.classList.remove("badge-bounce");
                void badge.offsetWidth;
                badge.classList.add("badge-bounce");
            }
        }

        function updatePageItemCount() {
            const remaining = document.querySelectorAll(".favorite-card").length;
            const countBadge = document.getElementById("favorite-item-count");
            if (countBadge) countBadge.innerText = remaining + " Items";

            if (remaining === 0) {
                document.getElementById("favorites-empty-state").style.display = "";
                document.getElementById("move-all-btn").style.display = "none";
            }
        }

        document.querySelectorAll(".move-to-cart-btn").forEach(btn => {
            btn.addEventListener("click", function() {
                const productId = this.dataset.productId;

                this.classList.add("btn-pop");
                setTimeout(() => this.classList.remove("btn-pop"), 300);

                fetch("/Home/TransferFavoriteToCart", {
                    method: "POST",
                    headers: { "Content-Type": "application/x-www-form-urlencoded" },
                    body: "productId=" + encodeURIComponent(productId)
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            updateCartBadge(data.cartCount);
                            showLocalToast(data.message);
                        } else {
                            showLocalToast(data.message);
                        }
                    })
                    .catch(err => console.error("AJAX error:", err));
            });
        });

        const moveAllBtn = document.getElementById("move-all-btn");
        if (moveAllBtn) {
            moveAllBtn.addEventListener("click", function() {
                this.classList.add("btn-pop");
                setTimeout(() => this.classList.remove("btn-pop"), 300);

                fetch("/Home/TransferAllFavoritesToCart", { method: "POST" })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            updateCartBadge(data.cartCount);
                            showLocalToast(data.message);
                        } else {
                            showLocalToast(data.message);
                        }
                    })
                    .catch(err => console.error("AJAX error:", err));
            });
        }

        document.querySelectorAll(".remove-favorite-btn").forEach(btn => {
            btn.addEventListener("click", function() {
                if (!confirm("Remove this item from your favorites?")) return;

                const productId = this.dataset.productId;

                fetch("/Home/RemoveFavoriteAjax", {
                    method: "POST",
                    headers: { "Content-Type": "application/x-www-form-urlencoded" },
                    body: "productId=" + encodeURIComponent(productId)
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            const card = document.getElementById("favorite-card-" + productId);
                            if (card) {
                                card.classList.add("removing");
                                setTimeout(() => {
                                    card.remove();
                                    updatePageItemCount();
                                }, 300);
                            }
                            updateFavoriteBadge(data.favoriteCount);
                            showLocalToast(data.message);
                        } else {
                            showLocalToast(data.message);
                        }
                    })
                    .catch(err => console.error("AJAX error:", err));
            });
        });
    });
</script>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
