@model List<RestaurantSystem.Models.ViewModels.CartItemVM>

@{
    ViewData["Title"] = "My Ordering Cart";
    decimal grandTotal = Model.Sum(item => item.Total);
}

<div class="container my-5">
    <div class="row">
        <div class="col-lg-8">
            <h2 class="mb-4">
                <i class="bi bi-cart3 me-2"></i>My Cart
                <span class="badge bg-secondary">@Model.Sum(i => i.Quantity) Items</span>
            </h2>

            @if (TempData["Info"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["Info"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (Model == null || !Model.Any())
            {
                <div class="card text-center p-5 shadow-sm">
                    <div class="card-body">
                        <i class="bi bi-cart-x text-muted" style="font-size: 4rem;"></i>
                        <h4 class="mt-3 text-secondary">Your cart is empty</h4>
                        <p class="text-muted">You haven't added any delicious dishes yet.</p>
                        <a href="@Url.Action("Menu", "Home")" class="btn btn-warning px-4 py-2 mt-2 text-white font-weight-bold">
                            <i class="bi bi-arrow-left me-2"></i>Browse Menu
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="card shadow-sm mb-4">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" class="ps-4">Dish Name</th>
                                    <th scope="col" class="text-center" style="width: 150px;">Price</th>
                                    <th scope="col" class="text-center" style="width: 180px;">Quantity</th>
                                    <th scope="col" class="text-center" style="width: 150px;">Subtotal</th>
                                    <th scope="col" class="text-end pe-4" style="width: 100px;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <span class="font-weight-bold text-dark fs-6">@item.ProductName</span>
                                        </td>

                                        <td class="text-center text-muted">
                                            RM @item.Price.ToString("F2")
                                        </td>

                                        <td class="text-center">
                                            <form asp-action="Update" asp-controller="Home" method="post" class="d-flex align-items-center justify-content-center">
                                                <input type="hidden" name="productId" value="@item.ProductId" />

                                                <div class="input-group input-group-sm" style="max-width: 120px;">
                                                    <button type="submit" name="quantity" value="@(item.Quantity - 1)" class="btn btn-outline-secondary">
                                                        <i class="bi bi-dash"></i>
                                                    </button>

                                                    <input type="text" readonly class="form-control text-center bg-white" value="@item.Quantity" />

                                                    <button type="submit" name="quantity" value="@(item.Quantity + 1)" class="btn btn-outline-secondary">
                                                        <i class="bi bi-plus"></i>
                                                    </button>
                                                </div>
                                            </form>
                                        </td>

                                        <td class="text-center font-weight-bold text-primary">
                                            RM @item.Total.ToString("F2")
                                        </td>

                                        <td class="text-end pe-4">
                                            <form asp-action="Remove" asp-controller="Home" method="post" onsubmit="return confirm('Are you sure you want to remove this item?');">
                                                <input type="hidden" name="productId" value="@item.ProductId" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-circle">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <a href="@Url.Action("Menu", "Home")" class="btn btn-outline-secondary px-4">
                    <i class="bi bi-arrow-left me-2"></i>Add More Dishes
                </a>
            }
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="col-lg-4 mt-4 mt-lg-0">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-warning text-white py-3">
                        <h5 class="mb-0 font-weight-bold">Order Summary</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Total items quantity:</span>
                            <span class="font-weight-bold">@Model.Sum(i => i.Quantity)</span>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between mb-4">
                            <span class="fs-5 font-weight-bold">Grand Total:</span>
                            <span class="fs-4 font-weight-bold text-success">RM @grandTotal.ToString("F2")</span>
                        </div>

                        <div class="d-grid gap-2">
                            <a asp-controller="Order" asp-action="Checkout" class="btn btn-warning text-white btn-lg font-weight-bold shadow-sm">
                                <i class="bi bi-credit-card-2-back-fill me-2"></i>Proceed to Checkout
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>


<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
